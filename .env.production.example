# Copy this file to .env and fill in your values before running docker compose

# Strong random secret — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret

# Public URL of your EC2 instance (used for CORS).
# If you add HTTPS later, change http to https.
# Multiple origins: comma-separated  e.g. http://1.2.3.4,https://yourdomain.com
CORS_ORIGIN=http://<EC2_PUBLIC_IP>
