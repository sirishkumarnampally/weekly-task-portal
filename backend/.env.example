PORT=3001
JWT_SECRET=change_this_to_a_strong_random_secret
NODE_ENV=development

# ── PostgreSQL (use ONE of the two options below) ──────────────────────────────

# Option A: single connection string (Railway / Render / Supabase / Neon)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Option B: individual fields (local Postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=weekly_task_portal
# DB_USER=postgres
# DB_PASSWORD=your_password
